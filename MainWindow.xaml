<Window x:Class="BackupDbServer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BackupDbServer.ViewModels"
        xmlns:converters="clr-namespace:BackupDbServer.Converters"
        Title="نظام النسخ الاحتياطي لقواعد البيانات" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Icon="/Resources/icon.ico"
        Background="{StaticResource MainBackgroundBrush}"
        FontFamily="{StaticResource ModernFontFamily}">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:ConnectionStatusColorConverter x:Key="ConnectionStatusColorConverter"/>
        <converters:BoolToRunningTextConverter x:Key="BoolToRunningTextConverter"/>
        
        <!-- Styles -->
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="DockerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="35"/>
        </Style>
    </Window.Resources>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط العنوان -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryAccentBrush}" Padding="15" CornerRadius="8" Margin="0,0,0,10">
            <TextBlock Text="مدير قواعد البيانات وخدمات IIS" 
                       Style="{StaticResource ModernHeaderStyle}"
                       HorizontalAlignment="Center"
                       Margin="0"
                       Foreground="{StaticResource MainBackgroundBrush}"/>
        </Border>

        <!-- تبويبات الوظائف الرئيسية -->
        <TabControl Grid.Row="1" Margin="0,10" BorderThickness="0" Background="Transparent" Padding="5">
            <!-- تبويب قواعد البيانات -->
            <TabItem Header="قواعد البيانات">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- شريط أزرار قواعد البيانات -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Button Height="35" Width="130" Margin="5"
                                Command="{Binding LoadDatabasesCommand}" 
                                ToolTip="تحديث قائمة قواعد البيانات">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Refresh}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="تحديث القائمة"/>
                            </StackPanel>
                        </Button>

                        <Button Height="35" Width="130" Margin="5"
                                Command="{Binding SaveSelectionCommand}" 
                                ToolTip="حفظ قواعد البيانات المحددة">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Save}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="حفظ الاختيار"/>
                            </StackPanel>
                        </Button>

                        <Button Height="35" Width="130" Margin="5"
                                Command="{Binding RunBackupCommand}" 
                                ToolTip="نسخ احتياطي للقواعد المحددة">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Database}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="نسخ احتياطي"/>
                            </StackPanel>
                        </Button>

                        <Button Height="35" Width="130" Margin="5"
                                Command="{Binding RestoreCommand}" 
                                ToolTip="استعادة قاعدة بيانات من نسخة احتياطية">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Refresh}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="استعادة"/>
                            </StackPanel>
                        </Button>

                        <Button Height="35" Width="130" Margin="5"
                                Command="{Binding ExecuteSqlForAllCommand}" 
                                ToolTip="تنفيذ سكربت SQL على القواعد المحددة">
                             <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Settings}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="تحديث SQL"/>
                            </StackPanel>
                        </Button>


                        <Button Height="35" Width="120" Margin="5,0"
                                Command="{Binding OpenCopyDatabaseCommand}" 
                                ToolTip="نسخ قاعدة بيانات مع تعديلات"
                                Style="{StaticResource ModernActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Save}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="نسخ قاعدة"/>
                            </StackPanel>
                        </Button>
                        <Button Height="35" Width="120" Margin="5,0"
                                Command="{Binding SelectAllCommand}" 
                                ToolTip="تحديد جميع قواعد البيانات"
                                Style="{StaticResource ModernActionButtonStyle}">
                             <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Refresh}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="تحديد الكل"/>
                            </StackPanel>
                        </Button>

                        <Button Content="☐ إلغاء التحديد" Height="35" Width="120" Margin="5,0"
                                Command="{Binding UnselectAllCommand}"
                                ToolTip="إلغاء تحديد جميع قواعد البيانات"/>

                        <!-- صيانة XML لكل القواعد -->
                        <Button Content="XML للكل ▾" Height="35" Width="120" Margin="5,0"
                                Click="DatabaseActions_Click"
                                ToolTip="تطبيق إجراءات صيانة XML على كل قواعد البيانات"
                                Style="{StaticResource ModernActionButtonStyle}"
                                Background="{StaticResource SecondaryAccentBrush}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="إيقاف XML للصيانة (الكل)"
                                              Command="{Binding PlacementTarget.DataContext.EnableMaintenanceAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="استرجاع XML (الكل)"
                                              Command="{Binding PlacementTarget.DataContext.DisableMaintenanceAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="تحديث حالة XML (الكل)"
                                              Command="{Binding PlacementTarget.DataContext.RefreshMaintenanceAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                    </StackPanel>

                    <!-- جدول قواعد البيانات -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Databases}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="تحديد" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="اسم قاعدة البيانات" Binding="{Binding DatabaseName}" Width="*" />
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="حالة XML" Binding="{Binding MaintenanceStatusText}" Width="150" />
                            <DataGridTemplateColumn Header="إجراءات" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="إجراءات ▾" Padding="8,4"
                                                Style="{StaticResource ModernActionButtonStyle}"
                                                Click="DatabaseActions_Click"
                                                HorizontalAlignment="Center">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="إيقاف XML للصيانة"
                                                              Command="{Binding PlacementTarget.DataContext.EnableMaintenanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="استرجاع XML"
                                                              Command="{Binding PlacementTarget.DataContext.DisableMaintenanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="تحديث الحالة"
                                                              Command="{Binding PlacementTarget.DataContext.RefreshMaintenanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- منطقة العمليات على القواعد الجديدة -->
                    <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Margin="0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="عمليات على القواعد الجديدة" Style="{StaticResource ModernHeaderStyle}" FontSize="14" Margin="0,0,0,10"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Margin="5" 
                                         Text="{Binding NewDbOperations}" 
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="80"
                                         Background="Transparent"
                                         Foreground="{StaticResource TextMainBrush}"
                                         BorderBrush="{StaticResource SurfaceBrush}"
                                         CaretBrush="{StaticResource PrimaryAccentBrush}"/>

                                <Button Grid.Column="1" Height="35" Width="100" Margin="5"
                                        Command="{Binding RunOperationsOnNewDbCommand}"
                                        ToolTip="تنفيذ عمليات SQL على القواعد الجديدة"
                                        Style="{StaticResource ModernActionButtonStyle}">
                                     <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Refresh}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="تنفيذ"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- تبويب إدارة IIS -->
            <TabItem Header="إدارة IIS">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- نشر التطبيق الآلي -->
                    <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Margin="0,5">
                          <Button Height="44" Margin="10"
                                Command="{Binding OpenAutoDeployCommand}"
                                ToolTip="فتح نافذة النشر الآلي للتطبيقات على IIS"
                                Style="{StaticResource ModernActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Settings}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="فتح نافذة النشر الآلي" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- المهام اليومية المجدولة -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Margin="0,5">
                          <Button Height="44" Margin="10"
                                Command="{Binding OpenDailyTasksCommand}"
                                ToolTip="إدارة المهام المجدولة اليومية على قواعد البيانات"
                                Style="{StaticResource ModernActionButtonStyle}"
                                Background="{StaticResource SecondaryAccentBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Refresh}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="إدارة المهام اليومية" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- صيانة وتسريع IIS -->
                    <Border Grid.Row="6" Style="{StaticResource ModernCardStyle}" Margin="0,5"
                            DataContext="{Binding IisMaintenance}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Data="{StaticResource Icon.Server}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="صيانة وتسريع IIS" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                            </StackPanel>

                            <!-- تحذير الصلاحيات -->
                            <Border Grid.Row="1" Background="{StaticResource ErrorBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                    Visibility="{Binding IsNotAdministrator, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="⚠️ عمليات IIS تتطلب تشغيل البرنامج كمسؤول (Administrator)."
                                           Foreground="White" TextWrapping="Wrap" FontWeight="Bold"/>
                            </Border>

                            <!-- أزرار العمليات -->
                            <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                                <Button Content="🔄 تحديث القائمة" Command="{Binding RefreshPoolsCommand}"
                                        Style="{StaticResource ModernActionButtonStyle}" Height="36" Margin="4" Padding="12,0"/>
                                <Button Content="⚡ تحسين المحدد" Command="{Binding OptimizeSelectedPoolCommand}"
                                        Style="{StaticResource ModernActionButtonStyle}" Height="36" Margin="4" Padding="12,0"/>
                                <Button Content="⚡ تحسين الكل" Command="{Binding OptimizeAllPoolsCommand}"
                                        Style="{StaticResource ModernActionButtonStyle}" Height="36" Margin="4" Padding="12,0"/>
                                <Button Content="♻️ إعادة تدوير Pool" Command="{Binding RecyclePoolCommand}"
                                        Background="{StaticResource SecondaryAccentBrush}" Foreground="{StaticResource TextMainBrush}"
                                        BorderThickness="0" Height="36" Margin="4" Padding="12,0"/>
                                <Button Content="🔁 إعادة تشغيل IIS كاملة" Command="{Binding RestartIisCommand}"
                                        Background="{StaticResource ErrorBrush}" Foreground="White"
                                        BorderThickness="0" Height="36" Margin="4" Padding="12,0"/>
                            </WrapPanel>

                            <!-- جدول الـ Application Pools -->
                            <DataGrid Grid.Row="3" ItemsSource="{Binding AppPools}"
                                      SelectedItem="{Binding SelectedAppPool}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column" FontSize="13" MinHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding State}" Width="90"/>
                                    <DataGridTextColumn Header="StartMode" Binding="{Binding StartMode}" Width="120"/>
                                    <DataGridTextColumn Header="خمول (د)" Binding="{Binding IdleTimeoutMinutes}" Width="80"/>
                                    <DataGridTextColumn Header="تدوير دوري (د)" Binding="{Binding PeriodicRestartMinutes}" Width="110"/>
                                    <DataGridTextColumn Header="الطابور" Binding="{Binding QueueLength}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="مُحسّن؟" Binding="{Binding IsOptimized}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- حالة العملية -->
                            <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="4,10,4,0"
                                       TextWrapping="Wrap" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="13"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>


            <TabItem Header="أعدادات">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">

                        <Button Height="35" Width="100" Margin="5,0"
                                Command="{Binding OpenSettingsCommand}" 
                                ToolTip="فتح نافذة الإعدادات">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Settings}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="الإعدادات"/>
                            </StackPanel>
                        </Button>
                        <Button Height="35" Width="130" Margin="5"
                                Command="{Binding OpenAutoBackupCommand}" 
                                ToolTip="إدارة النسخ الاحتياطي التلقائي"
                                IsEnabled="{Binding !IsBusy}"
                                Style="{StaticResource ModernActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Settings}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="النسخ التلقائي"/>
                            </StackPanel>
                        </Button>
        
                        <Button Height="35" Width="160" Margin="5"
                                Command="{Binding OpenScheduledBackupCommand}" 
                                ToolTip="إعداد جدولة النسخ الاحتياطي التلقائي"
                                IsEnabled="{Binding !IsBusy}"
                                Style="{StaticResource ModernActionButtonStyle}"
                                Background="{StaticResource SecondaryAccentBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Refresh}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="جدولة النسخ الاحتياطي"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </Grid>
                
            </TabItem>
       <!-- أضف هذا التبويب الجديد في MainWindow.xaml -->
    <!-- تاب عرض السجل -->
            <TabItem Header="📋 سجل العمليات">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- أزرار التحكم في السجل -->
                        <GroupBox Header="إدارة السجل" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                <Button Content="🔄 تحديث السجل" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding RefreshLogCommand}"
                                        ToolTip="تحديث سجل العمليات"/>
                                        
                                <Button Content="🗑️ مسح السجل" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding ClearLogCommand}"
                                        Background="IndianRed"
                                        Foreground="White"
                                        ToolTip="مسح جميع سجلات العمليات"/>
                                        
                                <Button Content="💾 تصدير السجل" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding ExportLogCommand}"
                                        Background="DarkGreen"
                                        Foreground="White"
                                        ToolTip="تصدير السجل إلى ملف"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- إحصائيات السجل -->
                        <GroupBox Header="إحصائيات العمليات" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="إجمالي العمليات" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalOperationsCount}" 
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="Blue" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="العمليات الناجحة" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SuccessfulOperationsCount}" 
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="Green" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="العمليات الفاشلة" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding FailedOperationsCount}" 
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="Red" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="العمليات الجارية" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding RunningOperationsCountFromLog}" 
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="Orange" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock Text="آخر عملية" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding LastOperationTime}" 
                                               FontSize="12" FontWeight="Bold" 
                                               Foreground="DarkBlue" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        
                        <!-- عرض السجل -->
                        <GroupBox Header="سجل العمليات" Style="{StaticResource GroupBoxStyle}">
                            <DataGrid ItemsSource="{Binding LogEntries}" 
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      AlternatingRowBackground="LightGray"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      MinHeight="300"
                                      MaxHeight="400"
                                      Margin="5"
                                      FlowDirection="RightToLeft">
                                      
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ والوقت" 
                                                        Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" 
                                                        Width="150"/>
                                                        
                                    <DataGridTextColumn Header="نوع العملية" 
                                                        Binding="{Binding OperationType}" 
                                                        Width="120"/>
                                                        
                                    <DataGridTextColumn Header="الحالة" 
                                                        Binding="{Binding Status}" 
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="نجح">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="فشل">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="جاري">
                                                        <Setter Property="Foreground" Value="Orange"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    
                                    <DataGridTextColumn Header="قاعدة البيانات" 
                                                        Binding="{Binding DatabaseName}" 
                                                        Width="150"/>
                                                        
                                    <DataGridTextColumn Header="الوصف" 
                                                        Binding="{Binding Description}" 
                                                        Width="*"/>
                                                        
                                    <DataGridTextColumn Header="المدة الزمنية" 
                                                        Binding="{Binding Duration}" 
                                                        Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        
                        <!-- فلترة السجل -->
                        <GroupBox Header="فلترة السجل" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel Margin="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="نوع العملية:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="1" 
                                              ItemsSource="{Binding OperationTypes}"
                                              SelectedItem="{Binding SelectedOperationType}"
                                              Margin="0,0,20,0"/>
                                              
                                    <TextBlock Grid.Column="2" Text="الحالة:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="3" 
                                              ItemsSource="{Binding StatusTypes}"
                                              SelectedItem="{Binding SelectedStatus}"
                                              Margin="0,0,20,0"/>
                                              
                                    <Button Grid.Column="4" Content="تطبيق الفلتر" 
                                            Command="{Binding ApplyFilterCommand}"
                                            Style="{StaticResource ActionButtonStyle}"/>
                                </Grid>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <CheckBox Content="عرض عمليات اليوم فقط" 
                                              IsChecked="{Binding ShowTodayOnly}"
                                              Margin="0,0,20,0"/>
                                    <CheckBox Content="عرض العمليات الناجحة فقط" 
                                              IsChecked="{Binding ShowSuccessOnly}"
                                              Margin="0,0,20,0"/>
                                    <CheckBox Content="عرض العمليات الفاشلة فقط" 
                                              IsChecked="{Binding ShowFailedOnly}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- تاب تقدم العمليات -->
            <TabItem Header="⚡ تقدم العمليات">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- العملية الحالية -->
                    <GroupBox Grid.Row="0" Header="العملية الحالية" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- اسم العملية -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="🔄 العملية الجارية:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentOperationDisplay}" FontSize="14" Margin="10,5" VerticalAlignment="Center"/>

                            <!-- شريط التقدم -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="📊 نسبة الإنجاز:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,5">
                                <ProgressBar Width="300" Height="20" Value="{Binding CurrentOperation.ProgressPercentage}" Maximum="100" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ProgressDisplay}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- الخطوة الحالية -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="📝 الخطوة الحالية:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentOperation.CurrentStep}" FontSize="12" Margin="10,5" VerticalAlignment="Center" TextWrapping="Wrap"/>

                            <!-- قاعدة البيانات الحالية -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="🗄️ قاعدة البيانات:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentOperation.CurrentDatabase}" FontSize="12" Margin="10,5" VerticalAlignment="Center"/>

                            <!-- معلومات الوقت -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="⏱️ الوقت:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Top"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,5">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="الوقت المنقضي: " FontSize="11"/>
                                    <TextBlock Text="{Binding CurrentOperation.ElapsedTime, StringFormat=hh\\:mm\\:ss}" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="الوقت المتبقي: " FontSize="11"/>
                                    <TextBlock Text="{Binding CurrentOperation.EstimatedTimeRemainingText}" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <!-- أزرار التحكم -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="🔄 تحديث" Width="80" Height="25" Margin="0,0,10,0"
                                            ToolTip="تحديث معلومات العملية الحالية"/>
                                    <Button Content="📋 تفاصيل" Width="80" Height="25" Margin="0,0,10,0"
                                            ToolTip="عرض تفاصيل أكثر للعملية"/>
                                    <Button Content="⏹️ إيقاف" Width="80" Height="25" 
                                            IsEnabled="{Binding CurrentOperation.IsRunning}"
                                            ToolTip="إيقاف العملية الحالية (إذا كان ذلك ممكناً)"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- إحصائيات سريعة -->
                    <GroupBox Grid.Row="1" Header="إحصائيات سريعة" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="LightBlue" Margin="5" Padding="10" CornerRadius="5">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="العمليات المكتملة" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding OperationHistory.Count}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="LightGreen" Margin="5" Padding="10" CornerRadius="5">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✅" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="الناجحة" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SuccessfulOperationsFromHistory}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="LightCoral" Margin="5" Padding="10" CornerRadius="5">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="❌" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="الفاشلة" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding FailedOperationsFromHistory}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="LightYellow" Margin="5" Padding="10" CornerRadius="5">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⏳" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="جارية الآن" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding RunningOperationsCount}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- سجل العمليات السابقة -->
                    <GroupBox Grid.Row="2" Header="سجل العمليات السابقة" Style="{StaticResource GroupBoxStyle}">
                        <DataGrid ItemsSource="{Binding OperationHistory}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusIcon}" Width="50"/>
                                <DataGridTextColumn Header="اسم العملية" Binding="{Binding OperationName}" Width="150"/>
                                <DataGridTextColumn Header="وقت البداية" Binding="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                                <DataGridTextColumn Header="المدة" Binding="{Binding ElapsedTime, StringFormat=hh\\:mm\\:ss}" Width="80"/>
                                <DataGridTextColumn Header="النسبة %" Binding="{Binding ProgressPercentage}" Width="80"/>
                                <DataGridTextColumn Header="الحالة النهائية" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
       
       
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Margin="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="إجمالي النسخ الاحتياطية:" Margin="5" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}"/>
                    <TextBlock Text="{Binding TotalBackups}" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Text="الناجحة:" Margin="20,5,5,5" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}"/>
                    <TextBlock Text="{Binding SuccessfulBackups}" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Text="الفاشلة:" Margin="20,5,5,5" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}"/>
                    <TextBlock Text="{Binding FailedBackups}" Foreground="{StaticResource ErrorBrush}" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding CurrentOperationStatus}" 
                           Foreground="{StaticResource PrimaryAccentBrush}" 
                           FontWeight="Bold" 
                           Margin="10" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

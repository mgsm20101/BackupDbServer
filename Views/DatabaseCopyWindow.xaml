<Window x:Class="BackupDbServer.Views.DatabaseCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:converters="clr-namespace:BackupDbServer.Converters"
        Title="نسخ قاعدة البيانات مع التعديلات" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MainBackgroundBrush}"
        Foreground="{StaticResource TextMainBrush}"
        FontFamily="{StaticResource ModernFontFamily}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- معلومات النسخ -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Path Data="{StaticResource Icon.Server}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="معلومات النسخ" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                </StackPanel>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="قاعدة البيانات المصدر:" Grid.Row="0" Grid.Column="0" 
                               VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,10"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Height="35"
                              ItemsSource="{Binding AvailableDatabases}"
                              SelectedItem="{Binding SourceDatabase}"/>

                    <TextBlock Text="اسم قاعدة البيانات الجديدة:" Grid.Row="1" Grid.Column="0" 
                               VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Height="35" Padding="8,5"
                             Text="{Binding TargetDatabaseName}"
                             Background="{StaticResource MainBackgroundBrush}"
                             Foreground="{StaticResource TextMainBrush}"
                             BorderBrush="{StaticResource SurfaceBrush}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- سكربتات SQL -->
            <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Path Data="{StaticResource Icon.Link}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text="سكربتات SQL (اختياري)" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                    </StackPanel>

                    <TextBox Grid.Row="1" 
                             Text="{Binding SqlScripts}" 
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             Background="{StaticResource MainBackgroundBrush}"
                             Foreground="{StaticResource TextMainBrush}"
                             BorderBrush="{StaticResource SurfaceBrush}"
                             Padding="10"/>

                    <TextBlock Grid.Row="2" Text="ملاحظة: يتم فصل السكربتات المتعددة بـ GO" 
                               FontStyle="Italic" Margin="0,10,0,0" Foreground="{StaticResource TextSubBrush}" FontSize="12"/>
                </Grid>
            </Border>

            <!-- تعديلات الملفات -->
            <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Path Data="{StaticResource Icon.Folder}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text="تعديلات الملفات (اختياري)" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                    </StackPanel>

                    <TextBox Grid.Row="1" 
                             Text="{Binding FileModifications}" 
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             Background="{StaticResource MainBackgroundBrush}"
                             Foreground="{StaticResource TextMainBrush}"
                             BorderBrush="{StaticResource SurfaceBrush}"
                             Padding="10"/>

                    <TextBlock Grid.Row="2" Margin="0,10,0,0" FontStyle="Italic" Foreground="{StaticResource TextSubBrush}" FontSize="12" LineHeight="18">
                        <Run Text="تنسيق التعديلات:" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="مسار_الملف|القيمة_القديمة=>القيمة_الجديدة"/>
                        <LineBreak/>
                        <Run Text="مثال: C:\app\config.json|localhost=>newserver" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- شريط التقدم والحالة -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Margin="0,16,0,0" Padding="20,15">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="جاري العمل..." HorizontalAlignment="Right" Foreground="{StaticResource TextSubBrush}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <ProgressBar Height="12" IsIndeterminate="{Binding IsBusy}" 
                             Style="{StaticResource ModernProgressBarStyle}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- الأزرار -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Width="140" Height="40" Margin="10,0,0,0"
                    Command="{Binding StartCopyCommand}"
                    IsEnabled="{Binding CanStartCopy}"
                    Style="{StaticResource ModernActionButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Save}" Fill="{StaticResource MainBackgroundBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="بدء النسخ"/>
                </StackPanel>
            </Button>
            <Button Content="إلغاء" Width="100" Height="40" Margin="10,0,0,0"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ModernActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>

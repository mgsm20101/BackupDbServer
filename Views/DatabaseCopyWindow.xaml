<Window x:Class="BackupDbServer.Views.DatabaseCopyWindow"
     

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:converters="clr-namespace:BackupDbServer.Converters"
        Title="نسخ قاعدة البيانات مع التعديلات" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--<converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InvertedBooleanConverter x:Key="InvertedBool"/>-->
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- معلومات النسخ -->
        <GroupBox Grid.Row="0" Header="معلومات النسخ" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="قاعدة البيانات المصدر:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="5" 
                          ItemsSource="{Binding AvailableDatabases}"
                          SelectedItem="{Binding SourceDatabase}"/>

                <Label Content="اسم قاعدة البيانات الجديدة:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="5" 
                         Text="{Binding TargetDatabaseName}"/>
            </Grid>
        </GroupBox>

        <!-- سكربتات SQL -->
        <GroupBox Grid.Row="1" Header="سكربتات SQL (اختياري)" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Height="150" 
                         Text="{Binding SqlScripts}" 
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"/>

                <TextBlock Grid.Row="1" Text="ملاحظة: يتم فصل السكربتات المتعددة بـ GO" 
                           FontStyle="Italic" Margin="0,5,0,0"/>
            </Grid>
        </GroupBox>

        <!-- تعديلات الملفات -->
        <GroupBox Grid.Row="2" Header="تعديلات الملفات (اختياري)">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" 
                         Text="{Binding FileModifications}" 
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"/>

                <TextBlock Grid.Row="1" Margin="0,5,0,0" FontStyle="Italic">
                    <Run Text="تنسيق التعديلات:"/>
                    <LineBreak/>
                    <Run Text="مسار_الملف|القيمة_القديمة=>القيمة_الجديدة"/>
                    <LineBreak/>
                    <Run Text="مثال: C:\app\config.json|localhost=>newserver"/>
                </TextBlock>
            </Grid>
        </GroupBox>

        <!-- شريط التقدم والحالة -->
        <StackPanel Grid.Row="3" Margin="0,10">
            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" Margin="0,0,0,5"/>
            <ProgressBar Height="20" IsIndeterminate="{Binding IsBusy}" 
                         Visibility="{Binding IsBusy}"/>
        </StackPanel>

        <!-- الأزرار -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="بدء النسخ" Width="100" Height="35" Margin="5"
                    Command="{Binding StartCopyCommand}"
                    IsEnabled="{Binding CanStartCopy}"/>
            <Button Content="إلغاء" Width="100" Height="35" Margin="5"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>

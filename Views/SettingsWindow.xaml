<Window x:Class="BackupDbServer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupDbServer.Views"
        xmlns:converters="clr-namespace:BackupDbServer.Converters"
        mc:Ignorable="d"
        Title="الإعدادات" Height="700" Width="500"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ConnectionStatusColorConverter x:Key="StatusColorConverter"/>
        
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <ScrollViewer>
        <StackPanel Margin="15">
            
            <!-- نوع الاتصال -->
            <GroupBox Header="🔗 نوع الاتصال" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <RadioButton Content="🖥️ SQL Server محلي" 
                                 IsChecked="{Binding IsLocalConnection}" 
                                 Margin="5" FontSize="12"/>
                    <RadioButton Content="🐳 SQL Server على Docker" 
                                 IsChecked="{Binding IsDockerConnection}" 
                                 Margin="5" FontSize="12"/>
                    <RadioButton Content="🌐 SQL Server بعيد" 
                                 IsChecked="{Binding IsRemoteConnection}" 
                                 Margin="5" FontSize="12"/>
                </StackPanel>
            </GroupBox>

            <!-- إعدادات الخادم المحلي/البعيد -->
            <GroupBox Header="⚙️ إعدادات الخادم" Style="{StaticResource GroupBoxStyle}"
                      Visibility="{Binding IsDockerConnection, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="اسم الخادم:" 
                               VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Server}" 
                             Margin="0,0,0,5" Height="25"/>

                    <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                              Content="استخدام منفذ مخصص" 
                              IsChecked="{Binding UseCustomPort}" 
                              Margin="0,5"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="رقم المنفذ:" 
                               VerticalAlignment="Center" Margin="0,0,10,5"
                               Visibility="{Binding UseCustomPort, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port}" 
                             Margin="0,0,0,5" Height="25"
                             Visibility="{Binding UseCustomPort, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </GroupBox>

            <!-- إعدادات Docker -->
            <GroupBox Header="🐳 إعدادات Docker" Style="{StaticResource GroupBoxStyle}"
                      Visibility="{Binding IsDockerConnection, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="اسم الحاوية:" 
                                   VerticalAlignment="Center" Margin="0,0,10,5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DockerContainerName}" 
                                 Margin="0,0,0,5" Height="25"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="رقم المنفذ:" 
                                   VerticalAlignment="Center" Margin="0,0,10,5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port}" 
                                 Margin="0,0,0,5" Height="25"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="الحالة:" 
                                   VerticalAlignment="Center" Margin="0,0,10,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DockerStatus}" 
                                   VerticalAlignment="Center" FontWeight="Bold"
                                   Foreground="{Binding DockerStatus, Converter={StaticResource StatusColorConverter}}"/>
                    </Grid>

                    <!-- أزرار إدارة Docker -->
                    <UniformGrid Rows="2" Columns="2" Margin="0,10,0,0">
                        <Button Content="فحص الحالة" Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding CheckDockerStatusCommand}"/>
                        <Button Content="إنشاء حاوية" Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding CreateDockerContainerCommand}"/>
                        <Button Content="تشغيل" Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding StartDockerContainerCommand}"/>
                        <Button Content="إيقاف" Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding StopDockerContainerCommand}"/>
                    </UniformGrid>
                </StackPanel>
            </GroupBox>

            <!-- إعدادات المصادقة -->
            <GroupBox Header="🔐 إعدادات المصادقة" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <RadioButton Content="مصادقة Windows" 
                                 IsChecked="{Binding UseWindowsAuthentication}" 
                                 Margin="5"/>
                    <RadioButton Content="مصادقة SQL Server" 
                                 IsChecked="{Binding UseSqlAuthentication}" 
                                 Margin="5"/>

                    <Grid Visibility="{Binding UseSqlAuthentication, Converter={StaticResource BoolToVisibilityConverter}}" 
                          Margin="20,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="اسم المستخدم:" 
                                   VerticalAlignment="Center" Margin="0,0,10,5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Username}" 
                                 Margin="0,0,0,5" Height="25"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="كلمة المرور:" 
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <PasswordBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" Height="25"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        
                        <!-- زر اختبار الاتصال -->
                        <Button Grid.Row="1" Grid.Column="2" Content="اختبار الاتصال" 
                                Margin="10,0,0,5" Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding TestConnectionCommand}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- إعدادات متقدمة -->
            <GroupBox Header="⚙️ إعدادات متقدمة" Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="مهلة الاتصال (ثانية):" 
                               VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionTimeout}" 
                             Margin="0,0,0,5" Height="25"/>

                    <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                              Content="الثقة في شهادة الخادم" 
                              IsChecked="{Binding TrustServerCertificate}" 
                              Margin="0,5"/>

                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                              Content="تشفير الاتصال" 
                              IsChecked="{Binding Encrypt}" 
                              Margin="0,5"/>
                </Grid>
            </GroupBox>

            <!-- مسارات النظام -->
            <GroupBox Header="📁 مسارات النظام" Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="المسار المؤقت:" 
                               VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TempPath}" 
                             Margin="0,0,0,5" Height="25"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="..." ToolTip="استعراض" 
                            Margin="5,0,0,5" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding BrowseCommand}" CommandParameter="Temp"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="مسار النسخ الاحتياطي:" 
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BackupPath}" 
                             Margin="0,0,0,5" Height="25"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="..." ToolTip="استعراض" 
                            Margin="5,0,0,5" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding BrowseCommand}" CommandParameter="Backup"/>
                </Grid>
            </GroupBox>

            <!-- معاينة سلسلة الاتصال -->
            <GroupBox Header="🔗 معاينة سلسلة الاتصال" Style="{StaticResource GroupBoxStyle}">
                <TextBox Text="{Binding ConnectionString}" IsReadOnly="True" 
                         TextWrapping="Wrap" Height="60" 
                         FontFamily="Consolas" FontSize="10"
                         Background="LightGray"/>
            </GroupBox>

            <!-- مؤشر التحميل لاختبار الاتصال -->
            <ProgressBar Height="5" Margin="5" IsIndeterminate="True"
                         Visibility="{Binding IsTestingConnection, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- أزرار الحفظ والإلغاء -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="💾 حفظ" Width="100" Height="35" Margin="5"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="❌ إلغاء" Width="100" Height="35" Margin="5"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding CloseWindowCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
            
        </StackPanel>
    </ScrollViewer>

</Window>

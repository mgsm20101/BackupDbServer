<Window x:Class="BackupDbServer.Views.DailyTaskManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupDbServer.Views"
        mc:Ignorable="d"
        Title="إدارة المهام اليومية" Height="600" Width="900"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط العنوان -->
        <Border Grid.Row="0" Background="#FF3F51B5" Padding="10" CornerRadius="4" Margin="0,0,0,10">
            <TextBlock Text="📅 إدارة المهام اليومية المجدولة"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- المحتوى الرئيسي -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ملاحظة توضيحية -->
            <Border Grid.Column="0" Background="#FFFFEB3B" Padding="8" Margin="0,0,0,5" CornerRadius="3">
                <TextBlock Text="💡 يمكن إضافة عدة مهام بأوقات تنفيذ مختلفة في نفس اليوم" 
                           FontSize="11" Foreground="#FF000000" TextWrapping="Wrap"/>
            </Border>
            
            <!-- قائمة المهام -->
            <DataGrid Grid.Column="0" 
                      ItemsSource="{Binding Tasks}"
                      SelectedItem="{Binding SelectedTask}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Margin="0,30,10,0"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="LightGray">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="مفعل" Binding="{Binding IsEnabled}" Width="60"/>
                    <DataGridTextColumn Header="اسم المهمة" Binding="{Binding TaskName}" Width="*"/>
                    <DataGridTextColumn Header="قاعدة البيانات" Binding="{Binding DatabaseName}" Width="150"/>
                    <DataGridTextColumn Header="نوع المهمة" Binding="{Binding Type}" Width="120"/>
                    <DataGridTextColumn Header="وقت التنفيذ" Binding="{Binding ExecutionTime, StringFormat='HH:mm'}" Width="100"/>
                    <DataGridTextColumn Header="الوقت المتبقي" Binding="{Binding TimeUntilNextRun}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#FF2196F3"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="آخر تنفيذ" Binding="{Binding LastExecutionTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="150"/>
                    <DataGridTemplateColumn Header="الحالة" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✅ نجح"/>
                                            <Setter Property="Foreground" Value="Green"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastExecutionSuccess}" Value="False">
                                                    <Setter Property="Text" Value="❌ فشل"/>
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LastExecutionTime}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="⏳ جديد"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- أزرار التحكم -->
            <StackPanel Grid.Column="1" Margin="0">
                <Button Content="➕ إضافة مهمة" 
                        Command="{Binding AddTaskCommand}"
                        Background="#FF4CAF50" 
                        Foreground="White"
                        FontWeight="Bold"/>
                
                <Button Content="✏ تعديل" 
                        Command="{Binding EditTaskCommand}"
                        Background="#FF2196F3" 
                        Foreground="White"/>
                
                <Button Content="🗑 حذف" 
                        Command="{Binding DeleteTaskCommand}"
                        Background="#FFF44336" 
                        Foreground="White"/>
                
                <Button Content="▶ اختبار" 
                        Command="{Binding TestTaskCommand}"
                        Background="#FFFF9800" 
                        Foreground="White"/>
                
                <Separator Margin="5,10"/>
                
                <Button Content="🔄 تحديث" 
                        Command="{Binding RefreshCommand}"
                        Background="#FF607D8B" 
                        Foreground="White"/>
            </StackPanel>
        </Grid>

        <!-- شريط الحالة -->
        <Border Grid.Row="2" Background="LightGray" Padding="10" CornerRadius="4" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                          Text="{Binding StatusMessage}"
                          FontSize="12"
                          VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="1"
                          Text="{Binding ServiceStatus}"
                          FontSize="12"
                          FontWeight="Bold"
                          VerticalAlignment="Center"
                          Foreground="#FF3F51B5"
                          Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
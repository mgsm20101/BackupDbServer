<Window x:Class="BackupDbServer.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupDbServer.Views"
        mc:Ignorable="d"
        Title="حماية البرنامج"
        Height="330" Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        Topmost="True"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma"
        Background="#1E1E2E"
        Foreground="#F9FAFB">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="🔒" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="HeaderText" Text="إدخال كلمة السر"
                       FontSize="18" FontWeight="Bold" Foreground="#F9FAFB"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- وصف -->
        <TextBlock Grid.Row="1" x:Name="DescriptionText"
                   Text="أدخل كلمة السر لفتح البرنامج"
                   Foreground="#9CA3AF" FontSize="13"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <!-- كلمة السر -->
        <PasswordBox Grid.Row="2" x:Name="PasswordInput"
                     FontSize="14" Padding="8" Height="38"
                     Background="#2D2D3F" Foreground="#F9FAFB"
                     BorderBrush="#10B981" BorderThickness="1"
                     KeyDown="Input_KeyDown"/>

        <!-- تأكيد كلمة السر (وضع الإعداد فقط) -->
        <PasswordBox Grid.Row="3" x:Name="ConfirmInput"
                     FontSize="14" Padding="8" Height="38" Margin="0,10,0,0"
                     Background="#2D2D3F" Foreground="#F9FAFB"
                     BorderBrush="#10B981" BorderThickness="1"
                     Visibility="Collapsed"
                     KeyDown="Input_KeyDown"/>

        <!-- رسالة الخطأ -->
        <TextBlock Grid.Row="4" x:Name="ErrorText"
                   Foreground="#EF4444" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <!-- الأزرار -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="موافق" Width="110" Height="38"
                    Background="#10B981" Foreground="#1E1E2E" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="إلغاء" Width="90" Height="38" Margin="10,0,0,0"
                    Background="#2D2D3F" Foreground="#F9FAFB"
                    BorderThickness="0" Cursor="Hand"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="BackupDbServer.Views.automationIIs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupDbServer.Views"
        xmlns:vm="clr-namespace:BackupDbServer.ViewModels"
        xmlns:converters="clr-namespace:BackupDbServer.Converters"
        mc:Ignorable="d"
        Title="نشر التطبيق الآلي" Height="750" Width="950"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MainBackgroundBrush}"
        Foreground="{StaticResource TextMainBrush}"
        FontFamily="{StaticResource ModernFontFamily}">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:DeployViewModel/>
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط العنوان المحدث -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,16" Background="{StaticResource SurfaceBrush}" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource Icon.Server}" Fill="{StaticResource PrimaryAccentBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                <TextBlock Text="نشر التطبيق الآلي على IIS" 
                           Style="{StaticResource ModernHeaderStyle}"
                           FontSize="20" 
                           VerticalAlignment="Center"
                           Margin="0"/>
            </StackPanel>
        </Border>

        <!-- تبويبات الإعدادات -->
        <TabControl Grid.Row="1">
            <!-- تبويب إعدادات SQL -->
            <TabItem Header="إعدادات SQL Server">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Link}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="إعدادات الاتصال" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="خادم SQL:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.SqlServer}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="اسم المستخدم:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.SqlAuthUser}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="كلمة المرور:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.SqlAuthPassword}" Height="35" Margin="0,0,0,12"/>

                                    <CheckBox Grid.Row="3" Grid.Column="1" Content="استخدام المصادقة المتكاملة (Windows Auth)"
                                              IsChecked="{Binding Config.UseIntegratedSecurity}" Foreground="{StaticResource TextMainBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Refresh}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="استعادة قاعدة البيانات" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ملف .bak:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.BakPath}" Height="35" Margin="0,0,10,12"/>
                                    <Button Grid.Row="0" Grid.Column="2" Command="{Binding BrowseBakFileCommand}" Width="100" Height="35" Margin="0,0,0,12" Style="{StaticResource ModernActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Folder}" Fill="{StaticResource MainBackgroundBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="تصفح..."/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="اسم قاعدة البيانات الجديدة:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.NewDatabaseName}" Height="35" Margin="0,0,0,12" Grid.ColumnSpan="2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="مجلد ملفات البيانات:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.DataFilesDir}" Height="35" Margin="0,0,0,12" Grid.ColumnSpan="2"/>

                                    <CheckBox Grid.Row="3" Grid.Column="1" Content="استبدال إذا كانت موجودة"
                                              IsChecked="{Binding Config.WithReplace}" Foreground="{StaticResource TextMainBrush}" Grid.ColumnSpan="2"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- تبويب إعدادات الشركة والترخيص -->
            <TabItem Header="الشركة والترخيص">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.World}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="تحديث بيانات الشركة" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="جدول الشركة:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.CompanyTable}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="عمود الاسم:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.CompanyNameColumn}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="عمود المفتاح:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.CompanyKeyColumn}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="قيمة المفتاح:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.CompanyKeyValue}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="الاسم الجديد للشركة:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,0"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Config.NewCompanyDisplayName}" Height="35"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Lock}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="إضافة ترخيص" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="قاعدة بيانات الترخيص:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.LicenseDbName}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="جدول الترخيص:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.LicenseTable}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="عمود معرف الشركة:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.LicenseCompanyIdColumn}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="مفتاح الترخيص:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.LicenseKeyValue}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="تاريخ الانتهاء:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,0"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Config.LicenseExpiry, StringFormat='yyyy-MM-dd'}" Height="35"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- تبويب إعدادات IIS -->
            <TabItem Header="إعدادات IIS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Folder}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="حزمة التطبيق" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ملف الحزمة (.zip):" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.ZipPackagePath}" Height="35" Margin="0,0,10,12"/>
                                    <Button Grid.Row="0" Grid.Column="2" Command="{Binding BrowseZipFileCommand}" Width="100" Height="35" Margin="0,0,0,12" Style="{StaticResource ModernActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Folder}" Fill="{StaticResource MainBackgroundBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="تصفح..."/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="مجلد wwwroot الأساسي:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.WwwRootBase}" Height="35" Margin="0,0,0,12" Grid.ColumnSpan="2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="اسم مجلد الشركة:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.CompanyFolderName}" Height="35" Grid.ColumnSpan="2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Settings}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="إعدادات الموقع والتطبيق" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="اسم الموقع في IIS:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.IisSiteName}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="اسم التطبيق:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.IisAppAlias}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="اسم Application Pool:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,12"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.AppPoolName}" Height="35" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="مفتاح appSettings للمجلد:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,0"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.AppSettingsFolderKey}" Height="35"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Settings}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="تحديث web.config" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="اسم Connection String:" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" Margin="0,0,15,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.ConnectionStringName}" Height="35"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- شريط الحالة والأزرار -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource PrimaryAccentBrush}"/>

                <Button Grid.Column="1" Command="{Binding DeployCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource ModernActionButtonStyle}"
                        Width="180" Height="45">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Refresh}" Fill="{StaticResource MainBackgroundBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text="🚀 نشر التطبيق" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

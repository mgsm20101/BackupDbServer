<Window x:Class="BackupDbServer.Views.automationIIs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupDbServer.Views"
        xmlns:vm="clr-namespace:BackupDbServer.ViewModels"
        xmlns:converters="clr-namespace:BackupDbServer.Converters"
        mc:Ignorable="d"
        Title="نشر التطبيق الآلي" Height="700" Width="900"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="25"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    

    <Window.DataContext>
        <vm:DeployViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط العنوان -->
        <Border Grid.Row="0" Background="#FF3F51B5" Padding="10" CornerRadius="4" Margin="0,0,0,10">
            <TextBlock Text="نشر التطبيق الآلي على IIS"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- تبويبات الإعدادات -->
        <TabControl Grid.Row="1" Margin="0,0,0,10">
            <!-- تبويب إعدادات SQL -->
            <TabItem Header="إعدادات SQL Server">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="إعدادات الاتصال" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="خادم SQL:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.SqlServer}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="اسم المستخدم:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.SqlAuthUser}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="كلمة المرور:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.SqlAuthPassword}" Style="{StaticResource TextBoxStyle}"/>

                                <CheckBox Grid.Row="3" Grid.Column="1" Content="استخدام المصادقة المتكاملة (Windows Auth)"
                                         IsChecked="{Binding Config.UseIntegratedSecurity}" Margin="0,10,0,0"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="استعادة قاعدة البيانات" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="ملف .bak:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.BakPath}" Style="{StaticResource TextBoxStyle}"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="تصفح..." Command="{Binding BrowseBakFileCommand}" Style="{StaticResource ButtonStyle}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="اسم قاعدة البيانات الجديدة:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.NewDatabaseName}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="مجلد ملفات البيانات:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.DataFilesDir}" Style="{StaticResource TextBoxStyle}"/>

                                <CheckBox Grid.Row="3" Grid.Column="1" Content="استبدال إذا كانت موجودة"
                                         IsChecked="{Binding Config.WithReplace}" Margin="0,10,0,0"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- تبويب إعدادات الشركة والترخيص -->
            <TabItem Header="الشركة والترخيص">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="تحديث بيانات الشركة" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="جدول الشركة:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.CompanyTable}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="عمود الاسم:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.CompanyNameColumn}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="عمود المفتاح:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.CompanyKeyColumn}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="قيمة المفتاح:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.CompanyKeyValue}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="الاسم الجديد للشركة:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Config.NewCompanyDisplayName}" Style="{StaticResource TextBoxStyle}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="إضافة ترخيص" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="قاعدة بيانات الترخيص:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.LicenseDbName}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="جدول الترخيص:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.LicenseTable}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="عمود معرف الشركة:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.LicenseCompanyIdColumn}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="مفتاح الترخيص:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.LicenseKeyValue}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="تاريخ الانتهاء:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Config.LicenseExpiry, StringFormat='yyyy-MM-dd'}" Style="{StaticResource TextBoxStyle}"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- تبويب إعدادات IIS -->
            <TabItem Header="إعدادات IIS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="حزمة التطبيق" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="ملف الحزمة (.zip):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.ZipPackagePath}" Style="{StaticResource TextBoxStyle}"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="تصفح..." Command="{Binding BrowseZipFileCommand}" Style="{StaticResource ButtonStyle}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="مجلد wwwroot الأساسي:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.WwwRootBase}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="اسم مجلد الشركة:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.CompanyFolderName}" Style="{StaticResource TextBoxStyle}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="إعدادات الموقع والتطبيق" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="اسم الموقع في IIS:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.IisSiteName}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="اسم التطبيق:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.IisAppAlias}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="اسم Application Pool:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.AppPoolName}" Style="{StaticResource TextBoxStyle}"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="مفتاح appSettings للمجلد:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.AppSettingsFolderKey}" Style="{StaticResource TextBoxStyle}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="تحديث web.config" Style="{StaticResource GroupBoxStyle}">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="اسم Connection String:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.ConnectionStringName}" Style="{StaticResource TextBoxStyle}"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- شريط الحالة والأزرار -->
        <Border Grid.Row="2" Background="LightGray" Padding="10" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                          VerticalAlignment="Center"
                          FontSize="14"
                          FontWeight="Bold"/>

                <Button Grid.Column="1" Content="🚀 نشر التطبيق"
                       Command="{Binding DeployCommand}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                       Style="{StaticResource ButtonStyle}"
                       Background="Green"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>

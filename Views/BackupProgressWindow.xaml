<Window x:Class="BackupDbServer.Views.BackupProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupDbServer.Views"
        mc:Ignorable="d"
        Title="تنفيذ النسخ الاحتياطي" Height="350" Width="550" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="{StaticResource MainBackgroundBrush}"
        Foreground="{StaticResource TextMainBrush}"
        FontFamily="{StaticResource ModernFontFamily}"
        FlowDirection="RightToLeft">
    
    <Grid Margin="24">
        <Border Style="{StaticResource ModernCardStyle}" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Path Data="{StaticResource Icon.History}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="جاري التنفيذ..." Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                </StackPanel>
                
                <ProgressBar x:Name="ProgressBar" Style="{StaticResource ModernProgressBarStyle}" Height="12" Minimum="0" Maximum="100" Margin="0,0,0,12"/>
                
                <TextBlock x:Name="ProgressCount" Foreground="{StaticResource TextSubBrush}" FontSize="13" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                
                <ListBox x:Name="ResultsList" 
                         Height="150" 
                         Background="{StaticResource SurfaceBrush}" 
                         BorderBrush="{StaticResource BorderBrush}"
                         Foreground="{StaticResource TextMainBrush}"
                         BorderThickness="1"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="BackupDbServer.Views.BackupProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupDbServer.Views"
        mc:Ignorable="d"
        Title="تنفيذ النسخ الاحتياطي" Height="250" Width="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="StatusText" FontSize="16" Margin="0,0,0,10"/>
            <ProgressBar x:Name="ProgressBar" Height="25" Minimum="0" Maximum="100" Margin="0,0,0,10"/>
            <TextBlock x:Name="ProgressCount" FontSize="14" Margin="0,0,0,10"/>
            <ListBox x:Name="ResultsList" Height="100"/>
        </StackPanel>
    </Grid>
</Window>

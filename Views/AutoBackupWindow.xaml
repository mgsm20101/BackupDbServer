<Window x:Class="BackupDbServer.Views.AutoBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BackupDbServer.Converters"
        Title="النسخ الاحتياطي التلقائي" Height="750" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MainBackgroundBrush}"
        Foreground="{StaticResource TextMainBrush}"
        FontFamily="{StaticResource ModernFontFamily}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:TimeOnlyToStringConverter x:Key="TimeOnlyConverter"/>
        <converters:ConnectionStatusColorConverter x:Key="StatusColorConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط الحالة العلوي المحدث -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.History}" Fill="{StaticResource PrimaryAccentBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="نظام النسخ الاحتياطي التلقائي" Style="{StaticResource ModernHeaderStyle}" FontSize="20" Margin="0"/>
                    
                    <Border Background="{Binding IsServiceRunning, Converter={StaticResource StatusColorConverter}}" 
                            CornerRadius="12" Padding="12,4" Margin="20,0,0,0">
                        <TextBlock Text="{Binding ServiceStatusText}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="100" Height="35" Margin="4"
                            Style="{StaticResource ModernActionButtonStyle}"
                            Command="{Binding StartServiceCommand}"
                            IsEnabled="{Binding IsServiceRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.World}" Fill="{StaticResource MainBackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="تشغيل"/>
                        </StackPanel>
                    </Button>
                    <Button Width="100" Height="35" Margin="4"
                            Style="{StaticResource ModernActionButtonStyle}"
                            Background="{StaticResource SurfaceBrush}"
                            Foreground="{StaticResource TextMainBrush}"
                            Command="{Binding StopServiceCommand}"
                            IsEnabled="{Binding IsServiceRunning}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Cancel}" Fill="{StaticResource TextMainBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="إيقاف"/>
                        </StackPanel>
                    </Button>
                    <Button Width="120" Height="35" Margin="4"
                            Style="{StaticResource ModernActionButtonStyle}"
                            Command="{Binding RunBackupNowCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Link}" Fill="{StaticResource MainBackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="تشغيل الآن"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- المحتوى الرئيسي -->
        <TabControl Grid.Row="1" Margin="0,0,0,10">

            <!-- تبويب الإعدادات العامة -->
            <TabItem Header="الإعدادات العامة">
                <ScrollViewer>
                    <StackPanel Margin="16">

                        <!-- إعدادات أساسية -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Settings}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="إعدادات أساسية" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" 
                                              Content="تفعيل النسخ الاحتياطي التلقائي"
                                              IsChecked="{Binding Config.IsEnabled}" 
                                              Foreground="{StaticResource TextMainBrush}"
                                              FontWeight="Bold" Margin="0,0,0,15"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="فترة التكرار (بالساعات):" 
                                               VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource TextSubBrush}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" 
                                             Text="{Binding Config.IntervalHours}" 
                                             Margin="0,0,0,10" Width="100" HorizontalAlignment="Left"
                                             Height="30" Padding="5"
                                             Background="{StaticResource MainBackgroundBrush}" 
                                             Foreground="{StaticResource TextMainBrush}"
                                             BorderBrush="{StaticResource SurfaceBrush}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="النسخة التالية:" 
                                               VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource TextSubBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" 
                                               Text="{Binding Config.NextBackupTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" 
                                               VerticalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>

                                    <CheckBox Grid.Row="3" Grid.ColumnSpan="2" 
                                              Content="حذف النسخ القديمة تلقائياً"
                                              IsChecked="{Binding Config.DeleteOldBackups}" 
                                              Foreground="{StaticResource TextMainBrush}"
                                              Margin="0,5,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- إعدادات التوقيت -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Link}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="إعدادات التوقيت" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" 
                                              Content="استخدام وقت محدد يومياً بدلاً من الفترة الزمنية"
                                              IsChecked="{Binding Config.UseScheduledTime}" 
                                              Foreground="{StaticResource TextMainBrush}"
                                              FontWeight="Bold" Margin="0,0,0,15"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="وقت النسخ الاحتياطي:" 
                                               VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource TextSubBrush}"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBox Text="{Binding Config.ScheduledTime, Converter={StaticResource TimeOnlyConverter}, UpdateSourceTrigger=LostFocus}" 
                                                 Width="80" Height="30" Padding="5"
                                                 Background="{StaticResource MainBackgroundBrush}" 
                                                 Foreground="{StaticResource TextMainBrush}"
                                                 BorderBrush="{StaticResource SurfaceBrush}"
                                                 IsEnabled="{Binding Config.UseScheduledTime}"/>
                                        <TextBlock Text="(24 ساعة - مثال: 14:30)" 
                                                   VerticalAlignment="Center" Margin="10,0,0,0" 
                                                   Foreground="{StaticResource TextSubBrush}" FontSize="12" FontStyle="Italic"/>
                                    </StackPanel>

                                    <CheckBox Grid.Row="2" Grid.ColumnSpan="2" 
                                              Content="تشغيل مرة واحدة فقط (بدلاً من يومياً)"
                                              IsChecked="{Binding Config.RunOnlyOnce}" 
                                              IsEnabled="{Binding Config.UseScheduledTime}"
                                              Foreground="{StaticResource TextMainBrush}"
                                              Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" 
                                               Text="ملاحظة: عند استخدام الوقت المحدد، سيتم تجاهل فترة التكرار" 
                                               Margin="0,5,0,0" Foreground="{StaticResource PrimaryAccentBrush}" FontStyle="Italic"
                                               Visibility="{Binding Config.UseScheduledTime, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- إعدادات الاحتفاظ -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Folder}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="إعدادات الاحتفاظ" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="الاحتفاظ بالنسخ لمدة (بالأيام):" 
                                               VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSubBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" 
                                             Text="{Binding Config.RetentionDays}" 
                                             Width="100" HorizontalAlignment="Left"
                                             Height="30" Padding="5"
                                             Background="{StaticResource MainBackgroundBrush}" 
                                             Foreground="{StaticResource TextMainBrush}"
                                             BorderBrush="{StaticResource SurfaceBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- معلومات الجدولة الحالية -->
                        <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,10"
                                Visibility="{Binding Config.IsEnabled, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.World}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="معلومات الجدولة الحالية" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="حالة الخدمة:" 
                                               VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource TextSubBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" 
                                               Text="{Binding ServiceStatusText}" 
                                               VerticalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold"
                                               Foreground="{Binding IsServiceRunning, Converter={StaticResource StatusColorConverter}}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="نوع الجدولة:" 
                                               VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource TextSubBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" 
                                               VerticalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Config.UseScheduledTime}" Value="True">
                                                        <Setter Property="Text" Value="وقت محدد يومياً"/>
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Config.UseScheduledTime}" Value="False">
                                                        <Setter Property="Text" Value="فترة زمنية"/>
                                                        <Setter Property="Foreground" Value="#FFFFA500"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="النسخ التالي:" 
                                               VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource TextSubBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" 
                                               Text="{Binding Config.NextBackupTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" 
                                               VerticalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold" Foreground="#FF800080"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="قواعد البيانات:" 
                                               VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSubBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" 
                                               Text="{Binding SelectedDatabasesText}" 
                                               VerticalAlignment="Center" Margin="0" TextWrapping="Wrap" Foreground="{StaticResource TextMainBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- قواعد البيانات -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Server}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="قواعد البيانات المحددة" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="200"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                        <Button Width="130" Height="32"
                                                Style="{StaticResource ModernActionButtonStyle}"
                                                Command="{Binding LoadDatabasesCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Link}" Fill="{StaticResource MainBackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                                <TextBlock Text="تحديث القائمة"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding AvailableDatabases.Count, StringFormat='المتاحة: {0}'}" 
                                                   VerticalAlignment="Center" Margin="15,0,0,0" Foreground="{StaticResource TextSubBrush}"/>
                                    </StackPanel>

                                    <ListBox Grid.Row="1" ItemsSource="{Binding AvailableDatabases}" 
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             Background="{StaticResource MainBackgroundBrush}"
                                             BorderBrush="{StaticResource SurfaceBrush}"
                                             Foreground="{StaticResource TextMainBrush}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding DatabaseName}" 
                                                          IsChecked="{Binding IsSelected}"
                                                          Foreground="{StaticResource TextMainBrush}"
                                                          Margin="2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- حفظ الإعدادات -->
                        <Button Width="180" Height="45" HorizontalAlignment="Center" Margin="0,20,0,0"
                                Style="{StaticResource ModernActionButtonStyle}"
                                Command="{Binding SaveConfigCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Save}" Fill="{StaticResource MainBackgroundBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="حفظ الإعدادات" FontSize="15"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- تبويب Google Drive -->
            <TabItem Header="Google Drive">
                <ScrollViewer>
                    <StackPanel Margin="16">

                        <!-- إعدادات Google Drive -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Cloud}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="إعدادات Google Drive" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Row="0" Grid.ColumnSpan="3" 
                                              Content="رفع النسخ إلى Google Drive"
                                              IsChecked="{Binding Config.UploadToGoogleDrive}" 
                                              Foreground="{StaticResource TextMainBrush}"
                                              FontWeight="Bold" Margin="0,0,0,15"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ملف الاعتماد:" 
                                               VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource TextSubBrush}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" 
                                             Text="{Binding Config.GoogleDriveCredentialsPath}" 
                                             Margin="0,0,0,10" Height="30" Padding="5"
                                             Background="{StaticResource MainBackgroundBrush}" 
                                             Foreground="{StaticResource TextMainBrush}"
                                             BorderBrush="{StaticResource SurfaceBrush}"
                                             IsReadOnly="True"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="..." 
                                            ToolTip="استعراض" Width="35" Height="30" Margin="5,0,0,10"
                                            Style="{StaticResource ModernActionButtonStyle}"
                                            Command="{Binding SelectGoogleCredentialsCommand}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="اسم المجلد:" 
                                               VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource TextSubBrush}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" 
                                             Text="{Binding Config.GoogleDriveFolderName}" 
                                             Margin="0,0,0,10" Height="30" Padding="5"
                                             Background="{StaticResource MainBackgroundBrush}" 
                                             Foreground="{StaticResource TextMainBrush}"
                                             BorderBrush="{StaticResource SurfaceBrush}"/>

                                    <CheckBox Grid.Row="3" Grid.ColumnSpan="3" 
                                              Content="حذف الملفات المحلية بعد الرفع"
                                              IsChecked="{Binding Config.DeleteLocalAfterUpload}" 
                                              Foreground="{StaticResource TextMainBrush}"
                                              Margin="0,0,0,15"/>

                                    <Button Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left"
                                            Width="140" Height="35"
                                            Style="{StaticResource ModernActionButtonStyle}"
                                            Command="{Binding TestGoogleDriveCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Cloud}" Fill="{StaticResource MainBackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="اختبار الاتصال"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- إعدادات توقيت رفع Google Drive -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.History}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="إعدادات توقيت الرفع" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" 
                                              Content="رفع إلى Google Drive في وقت محدد (بدلاً من الرفع الفوري)"
                                              IsChecked="{Binding Config.UseGoogleDriveScheduledTime}" 
                                              Foreground="{StaticResource TextMainBrush}"
                                              FontWeight="Bold" Margin="0,0,0,15"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="وقت الرفع:" 
                                               VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource TextSubBrush}"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBox Text="{Binding Config.GoogleDriveUploadTime, Converter={StaticResource TimeOnlyConverter}, UpdateSourceTrigger=LostFocus}" 
                                                 Width="80" Height="30" Padding="5"
                                                 Background="{StaticResource MainBackgroundBrush}" 
                                                 Foreground="{StaticResource TextMainBrush}"
                                                 BorderBrush="{StaticResource SurfaceBrush}"
                                                 IsEnabled="{Binding Config.UseGoogleDriveScheduledTime}"/>
                                        <TextBlock Text="(24 ساعة - مثال: 03:00)" 
                                                   VerticalAlignment="Center" Margin="10,0,0,0" 
                                                   Foreground="{StaticResource TextSubBrush}" FontSize="12" FontStyle="Italic"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" 
                                               Text="ملاحظة: عند تفعيل الرفع المجدول، ستتم إضافة الملفات إلى قائمة انتظار ليتم رفعها في الوقت المحدد يومياً" 
                                               Margin="0,5,0,0" Foreground="{StaticResource PrimaryAccentBrush}" FontStyle="Italic" TextWrapping="Wrap"
                                               Visibility="{Binding Config.UseGoogleDriveScheduledTime, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- إرشادات إعداد Google Drive -->
                        <Border Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource Icon.Settings}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="إرشادات إعداد Google Drive" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource TextMainBrush}">
                                    <Run Text="لإعداد Google Drive API:"/>
                                    <LineBreak/>
                                    <Run Text="1. انتقل إلى Google Cloud Console" Foreground="{StaticResource TextSubBrush}"/>
                                    <LineBreak/>
                                    <Run Text="2. إنشاء مشروع جديد أو اختر مشروع موجود" Foreground="{StaticResource TextSubBrush}"/>
                                    <LineBreak/>
                                    <Run Text="3. تفعيل Google Drive API" Foreground="{StaticResource TextSubBrush}"/>
                                    <LineBreak/>
                                    <Run Text="4. إنشاء بيانات اعتماد (OAuth 2.0)" Foreground="{StaticResource TextSubBrush}"/>
                                    <LineBreak/>
                                    <Run Text="5. تحميل ملف credentials.json" Foreground="{StaticResource TextSubBrush}"/>
                                    <LineBreak/>
                                    <Run Text="6. اختر الملف هنا واختبر الاتصال" Foreground="{StaticResource TextSubBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- تبويب سجل النسخ -->
            <TabItem Header="سجل النسخ">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <Path Data="{StaticResource Icon.History}" Fill="{StaticResource PrimaryAccentBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/>
                        <TextBlock Text="آخر النسخ الاحتياطية" Style="{StaticResource ModernHeaderStyle}" FontSize="18" Margin="0"/>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="8,2" Margin="15,0,0,0">
                            <TextBlock Text="{Binding RecentBackups.Count, StringFormat='({0} نسخة)'}" 
                                       VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentBackups}" 
                              Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="قاعدة البيانات" Binding="{Binding DatabaseName}" Width="150"/>
                            <DataGridTextColumn Header="وقت النسخ" 
                                                Binding="{Binding BackupTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" 
                                                Width="150"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="Success">
                                                <Setter Property="Foreground" Value="#FF4CAF50"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Failed">
                                                <Setter Property="Foreground" Value="#FFF44336"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="InProgress">
                                                <Setter Property="Foreground" Value="#FFFFC107"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="حجم الملف" Width="120">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="FileSizeBytes" StringFormat="{}{0:N0} bytes"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="المدة" Width="100">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Duration" StringFormat="{}{0:hh\:mm\:ss}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="رسالة الخطأ" Binding="{Binding ErrorMessage}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- شريط الحالة السفلي المحدث -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Height="50" CornerRadius="8" Padding="15,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource Icon.Settings}" Fill="{StaticResource TextSubBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0"/>
                <TextBlock Text="الحالة: " Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,12" Background="{StaticResource MainBackgroundBrush}"/>

                <TextBlock Text="الخدمة: " Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding ServiceStatusText}" VerticalAlignment="Center" FontWeight="Bold"
                           Foreground="{Binding IsServiceRunning, Converter={StaticResource StatusColorConverter}}"/>
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,12" Background="{StaticResource MainBackgroundBrush}"/>

                <StackPanel Orientation="Horizontal" Visibility="{Binding Config.IsEnabled, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="قواعد البيانات: " Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding SelectedDatabasesText}" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
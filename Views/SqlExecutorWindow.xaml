<Window x:Class="BackupDbServer.Views.SqlExecutorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:BackupDbServer.ViewModels"
        xmlns:converters="clr-namespace:BackupDbServer.Converters"
        mc:Ignorable="d"
        Title="تنفيذ سكربت SQL على القواعد المحددة" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MainBackgroundBrush}"
        Foreground="{StaticResource TextMainBrush}"
        FontFamily="{StaticResource ModernFontFamily}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.DataContext>
        <viewmodels:SqlExecutorViewModel />
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- عنوان النافذة المحدث -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,16" Background="{StaticResource SurfaceBrush}" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource Icon.Link}" Fill="{StaticResource PrimaryAccentBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                <TextBlock Text="تنفيذ سكربت SQL على القواعد المحددة" 
                           Style="{StaticResource ModernHeaderStyle}"
                           FontSize="20" 
                           VerticalAlignment="Center"
                           Margin="0"/>
            </StackPanel>
        </Border>

        <!-- قواعد البيانات المحددة -->
        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Path Data="{StaticResource Icon.Server}" Fill="{StaticResource PrimaryAccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="قواعد البيانات المحددة" Style="{StaticResource ModernHeaderStyle}" FontSize="14" Margin="0"/>
                </StackPanel>
                <TextBlock Text="{Binding SelectedDatabasesText}" 
                           FontWeight="Medium" 
                           Foreground="{StaticResource PrimaryAccentBrush}"
                           TextWrapping="Wrap"
                           FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- منطقة إدخال السكربت -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <Path Data="{StaticResource Icon.Link}" Fill="{StaticResource PrimaryAccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="سكربت SQL" Style="{StaticResource ModernHeaderStyle}" FontSize="16" Margin="0"/>
                </StackPanel>

                <TextBox Grid.Row="1" 
                         Text="{Binding SqlScript, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="13"
                         Background="{StaticResource MainBackgroundBrush}"
                         Foreground="{StaticResource TextMainBrush}"
                         BorderBrush="{StaticResource SurfaceBrush}"
                         Padding="12"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Width="150" Height="35" Margin="10,0,0,0"
                            Style="{StaticResource ModernActionButtonStyle}"
                            Command="{Binding LoadScriptFromFileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Folder}" Fill="{StaticResource MainBackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="تحميل من ملف"/>
                        </StackPanel>
                    </Button>
                    <Button Width="150" Height="35" Margin="10,0,0,0"
                            Style="{StaticResource ModernActionButtonStyle}"
                            Command="{Binding SaveScriptToFileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Save}" Fill="{StaticResource MainBackgroundBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="حفظ في ملف"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- منطقة النتائج -->
        <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}" Height="180" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Path Data="{StaticResource Icon.History}" Fill="{StaticResource PrimaryAccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="نتائج التنفيذ" Style="{StaticResource ModernHeaderStyle}" FontSize="14" Margin="0"/>
                </StackPanel>

                <TextBox Grid.Row="1" Text="{Binding ExecutionResults}" 
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="{StaticResource MainBackgroundBrush}"
                         Foreground="{StaticResource TextSubBrush}"
                         BorderBrush="{StaticResource SurfaceBrush}"
                         Padding="10"/>
            </Grid>
        </Border>

        <!-- أزرار التحكم وشريط التقدم -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0" 
                         Height="8" 
                         VerticalAlignment="Center"
                         Margin="0,0,20,0"
                         IsIndeterminate="{Binding IsBusy}"
                         Style="{StaticResource ModernProgressBarStyle}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="150" Height="40" Margin="10,0,0,0"
                        Command="{Binding ExecuteScriptCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Style="{StaticResource ModernActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Link}" Fill="{StaticResource MainBackgroundBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="تنفيذ السكربت" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                
                <Button Content="إلغاء" Width="100" Height="40" Margin="10,0,0,0"
                        Style="{StaticResource ModernActionButtonStyle}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>


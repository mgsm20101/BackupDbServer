<Window x:Class="BackupDbServer.Views.SqlExecutorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:BackupDbServer.ViewModels"
        xmlns:converters="clr-namespace:BackupDbServer.Converters"
        mc:Ignorable="d"
        Title="تنفيذ سكربت SQL على القواعد المحددة" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.DataContext>
        <viewmodels:SqlExecutorViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- عنوان النافذة -->
        <Border Grid.Row="0" Background="#FF3F51B5" Padding="10" CornerRadius="4" Margin="0,0,0,10">
            <TextBlock Text="تنفيذ سكربت SQL على القواعد المحددة" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- قواعد البيانات المحددة -->
        <GroupBox Grid.Row="1" Header="قواعد البيانات المحددة" Margin="0,0,0,10">
            <TextBlock Text="{Binding SelectedDatabasesText}" 
                       FontWeight="Bold" 
                       Foreground="DarkBlue"
                       TextWrapping="Wrap"
                       Margin="5"/>
        </GroupBox>

        <!-- منطقة إدخال السكربت -->
        <GroupBox Grid.Row="2" Header="سكربت SQL">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" 
                         Text="{Binding SqlScript, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Margin="5"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <Button Content=" تحميل من ملف" Width="120" Height="30" Margin="5,0"
                            Command="{Binding LoadScriptFromFileCommand}"/>
                    <Button Content=" حفظ في ملف" Width="120" Height="30" Margin="5,0"
                            Command="{Binding SaveScriptToFileCommand}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- منطقة النتائج -->
        <GroupBox Grid.Row="3" Header="نتائج التنفيذ" Height="150" Margin="0,10,0,0">
            <TextBox Text="{Binding ExecutionResults}" 
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="11"
                     Background="LightGray"
                     Margin="5"/>
        </GroupBox>

        <!-- أزرار التحكم -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content=" تنفيذ السكربت" Width="130" Height="35" Margin="5,0"
                    Command="{Binding ExecuteScriptCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Background="Green"
                    Foreground="White"
                    FontWeight="Bold"/>
            
            <Button Content=" إلغاء" Width="80" Height="35" Margin="5,0"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- شريط التقدم -->
        <ProgressBar Grid.Row="4" 
                     Height="4" 
                     Margin="0,5,0,0"
                     IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>

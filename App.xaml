<Application x:Class="BackupDbServer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BackupDbServer"
             xmlns:converters="clr-namespace:BackupDbServer.Converters"
            >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ModernDarkTheme.xaml"/>
                <ResourceDictionary Source="/Resources/IconDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- أيقونة التطبيق لشريط المهام -->
            <DrawingImage x:Key="TrayIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#FF2E8B57" Geometry="M8,2 L8,14 L16,14 L16,2 Z M10,4 L14,4 L14,6 L10,6 Z M10,8 L14,8 L14,10 L10,10 Z"/>
                        <GeometryDrawing Brush="#FF4169E1" Geometry="M2,6 L6,6 L6,16 L2,16 Z M3,8 L5,8 L5,10 L3,10 Z M3,12 L5,12 L5,14 L3,14 Z"/>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
        </ResourceDictionary>
    </Application.Resources>
</Application>